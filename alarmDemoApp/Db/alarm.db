record(ai, "PINI:NO") {
    field(PINI, "NO")
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm set pini_no")
    field(SCAN, "I/O Intr")
    field(VAL,  "55")
}
record(ai, "PINI:YES") {
    field(PINI, "YES")
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm set pini_yes")
    field(SCAN, "I/O Intr")
    field(VAL,  "55")
    field(LOLO, "3")
    field(LLSV, "MAJOR")
    field(LOW,  "5")
    field(LSV,  "MINOR")
    field(HIGH, "8")
    field(HSV,  "MINOR")
    field(HIHI,  "10")
    field(HHSV, "MAJOR")
}

record(ai, "TEST:ALARM") {
    field(PINI, "YES")
    field(VAL,  "10")
    field(LOLO, "20")
    field(LLSV, "MAJOR")
    field(LOW,  "20")
    field(LSV,  "MINOR")
    field(HIGH, "50")
    field(HSV,  "MINOR")
    field(HIHI,  "60")
    field(HHSV, "MAJOR")
}

